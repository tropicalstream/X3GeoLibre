{
  "manifest_version": 2,
  "name": "x3geolibre-bridge",
  "version": "1.0",
  "description": "Glasses bridge for GeoLibre Web: geolocation feed, right-click dispatch, icon rail.",
  "content_scripts": [
    {
      "matches": ["https://web.geolibre.app/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "bridge@x3geolibre.app"
    }
  }
}
